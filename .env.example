# NESS Suite — copy to .env and adjust

# Mail domain (MX must point here for public reception)
MAIL_DOMAIN=ourdomain.com

# HTTP bind
HTTP_HOST=0.0.0.0
HTTP_PORT=5000

# SMTP bind (25 needs root; Termux/non-root -> 2525)
SMTP_HOST=0.0.0.0
SMTP_PORT=25
SMTP_FALLBACK_PORT=2525

# SQLite path (default: ./tempmail.db)
# DB_PATH=tempmail.db

# Treasury address for NCH payments (REQUIRED in production)
NCH_PAYMENT_ADDRESS=2g63TwBbnH3EtXMpSoHuyKgAx4ydRvuRDiY

# Comma-separated PrivateNess explorer base URLs
NESS_EXPLORER_URLS=https://ness-explorer.magnetosphere.net,https://explorer.privateness.network

# Public site origin for absolute Open Graph URLs (recommended in production)
# PUBLIC_BASE_URL=https://suite.example.com

# Payment rules
PAYMENT_TX_MAX_AGE_SEC=604800
EXPLORER_TIMEOUT_SEC=12
PAYMENT_MIN_CONFIRMATIONS=0

# Only these peers may set X-Forwarded-For (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# Optional tier price overrides (NCH) — TempMail
# PRICE_FLASH_NCH=80
# PRICE_SESSION_NCH=350
# PRICE_DAY_NCH=900
# PRICE_WEEK_NCH=3200
# PRICE_MONTH_NCH=9000

# Storage plans (NCH prices + capacity)
STORAGE_PRICE_SPARK_NCH=0
STORAGE_PRICE_FLASH_NCH=80
STORAGE_PRICE_DAY_NCH=450
STORAGE_PRICE_WEEK_NCH=1600
STORAGE_PRICE_MONTH_NCH=4800

STORAGE_MAX_MB_SPARK=100
STORAGE_MAX_MB_FLASH=5120
STORAGE_MAX_MB_DAY=20480
STORAGE_MAX_MB_WEEK=102400
STORAGE_MAX_MB_MONTH=512000

STORAGE_TTL_SPARK_MIN=1440
STORAGE_TTL_FLASH_MIN=10080
STORAGE_TTL_DAY_MIN=43200
STORAGE_TTL_WEEK_MIN=129600
STORAGE_TTL_MONTH_MIN=525600

# NESS Burn plan prices (NCH) — independent catalogue
# BURN_PRICE_FLASH_NCH=100
# BURN_PRICE_SESSION_NCH=420
# BURN_PRICE_DAY_NCH=1100
# BURN_PRICE_WEEK_NCH=3800
# BURN_PRICE_MONTH_NCH=11000

# Burn storage directory (default: ./burn_data)
# BURN_STORAGE_DIR=burn_data

# Wormhole access (NCH). Price 0 = free tool.
WORMHOLE_DPO_PRICE_NCH=1400
WORMHOLE_OFFLINE_PRICE_NCH=1400
WORMHOLE_DPO_TTL_MIN=10080
WORMHOLE_OFFLINE_TTL_MIN=10080

# Flask body limit (MB). Raise on VPS for large vault tiers.
# MAX_CONTENT_LENGTH_MB=2048

# Dev only — never enable on a public host
# FLASK_DEBUG=1

# EmerSSH / Emercoin NVS (optional)
# EMERCOIN_RPC_URL=http://127.0.0.1:6662
# EMERCOIN_RPC_USER=rpcuser
# EMERCOIN_RPC_PASS=rpcpass
# EMERCOIN_NVS_DAYS=365
# SSH_MAX_KEYS_PER_DEVICE=20
# SSH_ALLOW_LOCAL_ACTIVATE=0
